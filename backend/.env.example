# Database Configuration
MONGODB_URI=mongodb://localhost:27017/smart-deal-finder
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/smart-deal-finder

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# AI Services
GEMINI_API_KEY=your-gemini-api-key-here
# Alternative: OPENAI_API_KEY=your-openai-api-key-here

# Server Configuration
PORT=5000
NODE_ENV=development

# Web Scraping Configuration
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; SmartDealBot/1.0; +https://smartdealfinder.com/bot)
SCRAPER_RATE_LIMIT_DELAY=2000
SCRAPER_MAX_RETRIES=3

# API Keys (if available)
AMAZON_API_KEY=
FLIPKART_AFFILIATE_ID=
EBAY_APP_ID=

# Cache TTL (in seconds)
CACHE_PRICE_TTL=21600
CACHE_PRODUCT_TTL=86400
CACHE_SEARCH_TTL=1800

# Logging
LOG_LEVEL=info
